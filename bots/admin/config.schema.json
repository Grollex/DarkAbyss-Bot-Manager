{
  "schema_version": 1,
  "type": "object",
  "required": [
    "allow_server_administrators",
    "allowed_user_ids",
    "allowed_role_ids",
    "audit_channel_id"
  ],
  "additionalProperties": true,
  "properties": {
    "allow_server_administrators": {
      "type": "boolean"
    },
    "allowed_user_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "allowed_role_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "ai_allowed_user_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "ai_allowed_role_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "ai_control_channel_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    },
    "ai_confirmation_mode": {
      "type": "string",
      "pattern": "^(plan|strict)$"
    },
    "ai_read_message_content": {
      "type": "boolean"
    },
    "ai_mention_enabled": {
      "type": "boolean"
    },
    "game_presence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "guild_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]+$"}, {"type": "integer"}]},
        "channel_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]+$"}, {"type": "integer"}]},
        "delay_minutes": {"type": "integer"},
        "user_cooldown_minutes": {"type": "integer"},
        "group_cooldown_minutes": {"type": "integer"},
        "guild_cooldown_minutes": {"type": "integer"},
        "voice_aware": {"type": "boolean"},
        "allowlist": {"type": "array", "items": {"type": "string"}},
        "ignore_list": {"type": "array", "items": {"type": "string"}},
        "ai_rewrite": {"type": "boolean"}
      }
    },
    "ai_mention_channel_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "audit_channel_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    }
  }
}
