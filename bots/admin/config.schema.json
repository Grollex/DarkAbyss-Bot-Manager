{
  "schema_version": 1,
  "type": "object",
  "required": [
    "allow_server_administrators",
    "allowed_user_ids",
    "allowed_role_ids",
    "audit_channel_id"
  ],
  "additionalProperties": true,
  "properties": {
    "allow_server_administrators": {
      "type": "boolean"
    },
    "allowed_user_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "allowed_role_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "ai_allowed_user_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "ai_allowed_role_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "ai_control_channel_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    },
    "ai_confirmation_mode": {
      "type": "string",
      "pattern": "^(plan|strict)$"
    },
    "ai_read_message_content": {
      "type": "boolean"
    },
    "ai_mention_enabled": {
      "type": "boolean"
    },
    "ai_mention_channel_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "audit_channel_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^(en|ru)$"
    },
    "social_awareness_enabled": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "social_awareness_channel_ids": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        ]
      }
    },
    "social_awareness_replies_per_hour": {
      "type": "integer"
    },
    "social_awareness_lore_enabled": {
      "type": "boolean"
    },
    "content_filter_enabled": {
      "type": "boolean"
    },
    "content_filter_immediate": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(hate|threat|harassment|family|insult|toxicity)$"
      }
    },
    "message_policies_enabled": {
      "type": "boolean"
    },
    "message_policies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
